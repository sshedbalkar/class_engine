{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "CMake_uclean",
			"linux": {
				"command": "${workspaceRoot}/scripts/linux/build_clean.sh"
			},
			"options": {
				"cwd": "${workspaceRoot}/build"
			},
			"problemMatcher": [],
			"detail": "CMake template clean task",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"revealProblems": "onProblem",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"type": "shell",
			"label": "Build_delete",
			"linux": {
				"command": "${workspaceRoot}/scripts/linux/build_delete.sh"
			},
			"options": {
				"cwd": "${workspaceRoot}/build"
			},
			"problemMatcher": [],
			"detail": "Build Folder delete task",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"revealProblems": "onProblem",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "cpp_format_file",
			"type": "shell",
			"linux": {
				"command": "${workspaceRoot}/scripts/linux/file_format.sh"
			},
			"options": {
				"cwd": "${workspaceRoot}"
			},
			"args": [
				"${file}"
			],
			"group": "none",
			"presentation": {
				"echo": false,
				"reveal": "never",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			},
			"problemMatcher": "$gcc"
		},
		{
			"type": "shell",
			"label": "Valgrind_run",
			"linux": {
				"command": "valgrind"
			},
			"options": {
				"cwd": "${workspaceRoot}/bin/64/Debug/"
			},
			"args": [
				"--leak-check=full", "--show-leak-kinds=all", "--track-origins=yes", "-v", "./Test2"
			],
			"detail": "Valgrind run task",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"revealProblems": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "Process_kill",
			"type": "process",
			"linux": {
				"command": "${workspaceRoot}/scripts/linux/proc_term.sh",
				"options": {
					"cwd": "${workspaceRoot}/bin/64/Debug/"
				}
			},
			"args": [
				"Test2"
			],
			"group": "test",
			"detail": "Terminate Application",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"revealProblems": "always",
				"focus": true,
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": false
			}
		}
	]
}